<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#141414;font-family:'Outfit',sans-serif;color:#fff;overflow-x:hidden}

.rev-section{padding:52px 0 56px;overflow:hidden}

/* ── Header ── */
.rev-header{max-width:1100px;margin:0 auto 32px;padding:0 24px;text-align:center}
.rev-tag{
  display:inline-flex;align-items:center;gap:7px;
  font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  color:#dc2626;margin-bottom:12px;
}
.rev-tag::before,.rev-tag::after{content:'';width:24px;height:2px;background:#dc2626;display:inline-block}
.rev-title{font-size:clamp(26px,5vw,40px);font-weight:900;line-height:1.1;margin-bottom:10px}
.rev-title span{color:#dc2626}

/* Stat strip */
.stat-strip{
  display:inline-flex;align-items:center;gap:16px;
  background:#1a1a1a;border:2px solid #222;border-radius:10px;
  padding:10px 22px;
}
.stat-strip:hover{border-color:#dc2626}
.ss-rating{font-size:30px;font-weight:900;line-height:1}
.ss-stars{display:flex;gap:2px}
.ss-stars svg{width:18px;height:18px}
.ss-div{width:1px;height:28px;background:#2a2a2a}
.ss-count{text-align:left}
.ss-count .n{font-size:18px;font-weight:800;color:#dc2626}
.ss-count .l{font-size:10px;font-weight:600;color:#666;letter-spacing:1.5px;text-transform:uppercase}

/* ── Marquee ── */
.marquee-wrap{position:relative;padding:6px 0}
.marquee-wrap::before,.marquee-wrap::after{
  content:'';position:absolute;top:0;bottom:0;width:80px;z-index:3;pointer-events:none;
}
.marquee-wrap::before{left:0;background:linear-gradient(to right,#141414 0%,transparent 100%)}
.marquee-wrap::after{right:0;background:linear-gradient(to left,#141414 0%,transparent 100%)}

.marquee-track{
  display:flex;gap:18px;width:max-content;
  animation:marquee 40s linear infinite;
}
.marquee-track:hover{animation-play-state:paused}

@keyframes marquee{
  0%{transform:translateX(0)}
  100%{transform:translateX(-50%)}
}

/* ── Cards ── */
.m-card{
  flex-shrink:0;width:320px;
  background:linear-gradient(160deg,#1c1c1c 0%,#151515 100%);
  border:2px solid #222;border-radius:14px;
  padding:24px 22px 22px;
  position:relative;
  transition:border-color .3s,box-shadow .3s;
}
.m-card:hover{
  border-color:#dc2626;
  box-shadow:0 0 24px rgba(220,38,38,.1);
}

.m-card::before{
  content:'\201C';position:absolute;top:14px;right:18px;
  font-size:52px;font-weight:900;line-height:1;color:#dc2626;opacity:.08;
  pointer-events:none;
}

.mc-top{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.mc-avatar{
  width:40px;height:40px;border-radius:50%;flex-shrink:0;
  background:#dc2626;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:800;color:#fff;
}
.mc-name{font-size:14px;font-weight:700;line-height:1.2}
.mc-sub{font-size:11px;font-weight:400;color:#555}

.mc-stars{display:flex;gap:2px;margin-bottom:12px}
.mc-stars svg{width:14px;height:14px}

.mc-text{
  font-size:13.5px;font-weight:400;line-height:1.65;color:#bbb;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
}

/* ── Second row (reverse direction) ── */
.marquee-track.reverse{
  animation:marquee-rev 44s linear infinite;
}
@keyframes marquee-rev{
  0%{transform:translateX(-50%)}
  100%{transform:translateX(0)}
}

.row-gap{height:18px}
</style>
</head>
